# fx-880BTG PLUS: directory-local policy for the BITEX static deployment.
# Netlify's _headers is not interpreted by Apache.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ @@BITEX_PUBLIC_ORIGIN@@%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(zip|tar|gz|bak|log|php|phtml|phar|cgi|pl)$)">
    Require all denied
  </FilesMatch>
  <LimitExcept GET HEAD>
    Require all denied
  </LimitExcept>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType font/ttf .ttf
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), fullscreen=(self)"
  # GTM / Google Analytics, without Ads domains, inline scripts or unsafe-eval.
  # Google reference: https://developers.google.com/tag-platform/security/guides/csp
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
  Header always set Cache-Control "no-cache"
  <Files "sw.js">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
